# Supabase Credentials (optional - app automatically uses mock persistence if omitted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Meta Webhook Verification Token (set in Meta Business App Webhooks settings)
META_WEBHOOK_VERIFY_TOKEN=millionspaces_meta_leads_secret_token

# Admin Credentials
NEXT_PUBLIC_ADMIN_EMAIL=adminsl@millionspaces.com
ADMIN_PASSWORD=MsAdmin@2019

